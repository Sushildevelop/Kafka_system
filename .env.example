APP_NAME=Kafka Learning Project
APP_ENV=development
DEBUG=true

# Both URIs must address members of the SAME MongoDB replica set. The read URL
# can reuse the seed list; the driver selects a secondary via READ_PREFERENCE.
MONGODB_WRITE_URL=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_READ_URL=mongodb+srv://<user>:<password>@<cluster>/?retryReads=true
MONGODB_DATABASE=kafka_learning
# "secondary" fails a read when no replica is reachable. "secondaryPreferred"
# uses the primary only during replica unavailability.
MONGODB_READ_PREFERENCE=secondaryPreferred
MONGODB_WRITE_TIMEOUT_MS=5000

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=test-events
KAFKA_TEST_PARTITIONS=3
KAFKA_CONSUMER_GROUP=kafka-learning-group
KAFKA_AUTO_OFFSET_RESET=earliest
