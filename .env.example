APP_NAME=Study AI
APP_ENV=development
DEBUG=true
MONGODB_WRITE_URL=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_READ_URL=mongodb+srv://<user>:<password>@<cluster>/?retryReads=true
MONGODB_DATABASE=kafka_learning
MONGODB_READ_PREFERENCE=secondaryPreferred
MONGODB_WRITE_TIMEOUT_MS=5000
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=test-events
KAFKA_TEST_PARTITIONS=3
KAFKA_CONSUMER_GROUP=kafka-learning-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_CHAT_CONSUMER_GROUP=study-group-chat-fanout
KAFKA_CHAT_PARTITIONS=3
CHAT_MEDIA_MAX_SIZE_MB=50

# Google OAuth / OpenID Connect
GOOGLE_CLIENT_ID=<your-google-web-client-id>
GOOGLE_ALLOWED_CLIENT_IDS=
AUTH_SESSION_SECRET=<long-random-secret>
AUTH_SESSION_EXPIRE_MINUTES=1440
